# --- Modular Railway runtime (project.main) recommended configuration ---
RUN_MODE=RAILWAY_LIGHT
DATABASE_URL=
ENABLE_NOTIFICATION_ENGINE=true
TELEGRAM_SEND_STARTUP_MESSAGE=true
TELEGRAM_TEST_ON_STARTUP=false
TELEGRAM_MAX_MESSAGE_LENGTH=3900
TELEGRAM_MAX_RETRIES=3

ENABLE_DATA_COLLECTOR=true
ENABLE_RESEARCH_ENGINE=true
ENABLE_DECISION_ENGINE=true
ENABLE_STRATEGY_ENGINE=true
ENABLE_POSITION_MONITOR=true

COLLECTOR_PAIRS=BTC/USD,ETH/USD,SOL/USD,XRP/USD,ADA/USD,DOGE/USD,LINK/USD,AVAX/USD,AAVE/USD,LTC/USD,BCH/USD,TAO/USD,DOT/USD,XLM/USD,TRX/USD,ATOM/USD,ETC/USD,FIL/USD,NEAR/USD,UNI/USD
COLLECTOR_TIMEFRAMES=5m,15m,1h,4h
OPERATIONAL_TIMEFRAME=15m
COLLECTOR_OHLC_LIMIT=720
STRATEGY_OHLC_LIMIT=720
