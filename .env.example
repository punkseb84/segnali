MIN_HISTORICAL_EV_EUR=0.00
HISTORICAL_EV_TOLERANCE_EUR=0.05
# EV storico, regime e indicatori sono evidenze pesate. Impostare true solo per ripristinare il veto rigido.
HARD_BLOCK_NEGATIVE_HISTORICAL_EV=false
# Punteggio 0-100 del setup sulla candela corrente.
MIN_LIVE_SETUP_SCORE=45
# Soglia del punteggio complessivo per un segnale operativo di classe B.
MIN_OPERATIVE_SIGNAL_SCORE=55
# Sotto questa soglia il candidato non viene salvato né notificato; sopra può diventare watchlist C.
MIN_WATCHLIST_SIGNAL_SCORE=30
MIN_PROBABILITY_SAMPLE_SIZE=30
PROBABILITY_HORIZON_CANDLES=8

OPERATIVE_SIGNAL_CLASSES=A,B
WATCHLIST_SIGNAL_CLASSES=C
ENABLE_WATCHLIST_ALERTS=true
SIGNAL_COOLDOWN_MINUTES=45
AMBIGUOUS_CANDLE_MODE=conservative
DRY_RUN=true
DIAGNOSTIC_MODE=true

SCHEDULER_COLLECTOR_SECONDS=300
SCHEDULER_DECISION_SECONDS=300
SCHEDULER_STRATEGY_SECONDS=60
SCHEDULER_POSITION_MONITOR_SECONDS=60
SCHEDULER_RESEARCH_SECONDS=86400
# La ricerca è di supporto e gira in background: evitare batch continui che aumentano i costi Railway.
RESEARCH_BATCH_SIZE=100
MAX_RESEARCH_RUNTIME_MINUTES=10
RAILWAY_LIGHT_RESEARCH_SECONDS=3600
RUN_DATA_COLLECTOR_ON_STARTUP=true
